/// Recipe 14: secretlint pre-commit hook, prek-free.
///
/// Drops the `prek install` / `.pre-commit-config.yaml` dependency
/// when secretlint is the *only* hook you'd reach for. The recipe
/// uses pkfire's own `pkf hooks install` (recipe 13) and a single
/// `secretlint` task that scans the *staged* file set.
///
/// One-time setup
/// ---------------
///   pnpm add -D secretlint @secretlint/secretlint-rule-preset-recommend
///   cat > .secretlintrc.json <<'JSON'
///   {
///     "rules": [
///       { "id": "@secretlint/secretlint-rule-preset-recommend" }
///     ]
///   }
///   JSON
///   pkf hooks install
///
/// Per-commit behavior
/// -------------------
/// `.git/hooks/pre-commit` (the shim written by `pkf hooks install`)
/// runs `pkf run pre-commit`, which deps on this task. We scope the
/// scan to git-staged files via `git diff --cached --name-only -z`
/// so an unrelated repo-wide pnpm log file in your working tree
/// does not trip the hook.
///
/// If no files are staged (e.g. `git commit --amend` with no new
/// changes), the task exits 0 silently — secretlint would complain
/// about "no files" otherwise.
///
/// Relationship to prek / pre-commit
/// ---------------------------------
/// If you ALREADY use prek with `.pre-commit-config.yaml` for other
/// reasons (eslint, ruff, gitleaks, etc.), keep secretlint there and
/// don't enable this recipe — running the same scanner twice on
/// every commit is just slow. This recipe replaces prek for the
/// "secretlint-only" case, where adding a second hook manager just
/// to dispatch one tool is overhead.
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.5.0#/Taskfile.pkl"

/// Scan the staged file set with secretlint. Direct invocation —
/// no allowlist of "lintable" extensions, because secretlint's
/// preset already knows which file types to inspect and which to
/// skip. We just hand it whatever the user staged.
local secretlint: Task = new {
  name = "lint:secretlint"
  description = "Run secretlint against git-staged files"
  // Raw string (#"""..."""#) so the `\0` / `\n` escapes in the
  // shell command don't trip Pkl's regular string-escape rules.
  cmd =
    #"""
    set -euo pipefail
    # NUL-separated to handle filenames with spaces or newlines.
    # --diff-filter=ACMR: added, copied, modified, renamed (skip D = deleted).
    files=$(git diff --cached --name-only --diff-filter=ACMR -z)
    if [ -z "$files" ]; then
      exit 0
    fi
    # `xargs -0` is POSIX-portable enough for macOS BSD + GNU.
    printf '%s' "$files" | xargs -0 pnpm exec secretlint --
    """#
  cache = false
  // Re-run when the secretlint config changes; not strictly
  // necessary because cache is off, but lets `pkf run --print-hash`
  // surface the config dependency.
  inputs {
    ".secretlintrc.json"
    ".secretlintignore"
    "package.json"
    "pnpm-lock.yaml"
  }
}

/// Hook target. `pkf hooks install` wires `.git/hooks/pre-commit`
/// to this. Kept as a thin aggregator so you can add more gates
/// later (lint, typecheck, ...) without touching the hooks
/// installation.
local preCommit: Task = new {
  name = "pre-commit"
  description = "Pre-commit gate: secretlint"
  cmd = "echo pre-commit ok"
  cache = false
  deps { secretlint }
}

tasks { secretlint; preCommit }

// ---------------------------------------------------------------
// Adding more hooks later
// ---------------------------------------------------------------
//
// As the project grows, add sibling tasks and chain them into
// pre-commit's deps. Example: a ruff lint for Python sources.
//
//   local ruff = new Task {
//     name = "lint:ruff"
//     cmd = """
//       files=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -E '\.py$' || true)
//       [ -z "$files" ] && exit 0
//       printf '%s\n' "$files" | xargs ruff check
//       """
//     cache = false
//   }
//
//   local preCommit = new Task {
//     name = "pre-commit"; cmd = "echo pre-commit ok"; cache = false
//     deps { secretlint; ruff }
//   }
//
// `pkf hooks install` is idempotent, so re-running it after adding
// new hook tasks just updates the shim mapping.
