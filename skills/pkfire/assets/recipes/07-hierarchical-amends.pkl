/// Recipe 07: hierarchical amends ("Know Your Place" pattern).
///
/// Layout:
///
///   project/
///   ├── Taskfile.pkl              # this file: project-root template
///   └── services/
///       ├── api/
///       │   └── Taskfile.pkl      # amends "../../Taskfile.pkl"
///       └── web/
///           └── Taskfile.pkl      # amends "../../Taskfile.pkl"
///
/// Each leaf invokes pkfire on its own Taskfile:
///
///   pkf run -f services/api/Taskfile.pkl ci
///   pkf run -f services/web/Taskfile.pkl ci
///
/// The root provides shared `sources`, `tools`, and project-wide
/// tasks (`lint`, `format`). Leaves append their own service-specific
/// tasks via `tasks { ...new tasks }`.
///
/// This file is the *root*. The leaf example follows below in a
/// comment.
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.5.0#/Taskfile.pkl"

local sources: Listing<String> = new {
  "**/*.go"
  "go.mod"
  "go.sum"
}

local toolchain: Mapping<String, String> = new {
  ["go"] = "1.26"
}

local lint: Task = new {
  name = "lint"
  description = "Project-wide lint, runs from the repo root"
  cmd = "go vet ./..."
  inputs = sources
  tools = toolchain
}

local format: Task = new {
  name = "format"
  description = "Project-wide formatter check"
  cmd = "gofmt -l . | tee /dev/stderr | (! read)"
  inputs = sources
  tools = toolchain
}

tasks { lint; format }

