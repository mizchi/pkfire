/// Recipe 14: secretlint as a `pkf run pre-push` hook, prek-free.
///
/// Drops the `prek install` / `.pre-commit-config.yaml` dependency
/// when secretlint is the *only* hook you'd reach for. Uses
/// pkfire's own `pkf hooks install` (recipe 13) and a single
/// `secretlint` task that scans the diff range about to be pushed.
///
/// Why pre-push and not pre-commit
/// -------------------------------
/// pre-commit fires on every `git commit`, including amends and
/// fixups in the middle of a feature branch. secretlint is fast
/// but not free — running it on every micro-commit just to repeat
/// the same scan dozens of times in an afternoon is wasted
/// attention. pre-push fires once when you actually publish, with
/// the diff that's about to leave your machine. That's the only
/// moment a secret-leak gate really matters.
///
/// One-time setup
/// ---------------
///   pnpm add -D secretlint @secretlint/secretlint-rule-preset-recommend
///   cat > .secretlintrc.json <<'JSON'
///   {
///     "rules": [
///       { "id": "@secretlint/secretlint-rule-preset-recommend" }
///     ]
///   }
///   JSON
///   pkf hooks install
///
/// Per-push behavior
/// -----------------
/// `.git/hooks/pre-push` runs `pkf run pre-push`, which deps on
/// this task. We scope to the file set in the asymmetric diff
/// range `<push-target>..HEAD` — exactly the files about to leave
/// your machine. On a brand-new branch with no upstream we fall
/// back to scanning every tracked file (over-cautious, but safe).
///
/// Bypass for emergencies: `git push --no-verify`.
///
/// Relationship to prek / pre-commit
/// ---------------------------------
/// If you ALREADY use prek with `.pre-commit-config.yaml` for other
/// reasons (eslint, ruff, gitleaks, etc.), keep secretlint there
/// and don't enable this recipe — running the same scanner twice
/// is wasted CPU. This recipe replaces prek for the
/// "secretlint-only" case, where adding a second hook manager just
/// to dispatch one tool is overhead.
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.9.0#/Taskfile.pkl"

/// Scan the about-to-be-pushed diff with secretlint. Resolves the
/// upstream via `@{push}` (the configured push target — usually
/// but not always the same as `@{u}`), falling back to `@{u}` then
/// to a full `git ls-files` scan when no upstream exists.
local secretlint: Task = new {
  name = "lint:secretlint"
  description = "Run secretlint against files in the diff about to be pushed"
  // Raw string (#"""..."""#) so the `\0` / `\n` escapes in the
  // shell command don't trip Pkl's regular string-escape rules.
  cmd =
    #"""
    set -euo pipefail
    upstream=$(git rev-parse --symbolic-full-name '@{push}' 2>/dev/null \
            || git rev-parse --symbolic-full-name '@{u}' 2>/dev/null \
            || true)
    if [ -n "$upstream" ]; then
      # NUL-separated diff over <upstream>..HEAD.
      # --diff-filter=ACMR: added, copied, modified, renamed (skip D = deleted).
      files=$(git diff --name-only --diff-filter=ACMR -z "${upstream}..HEAD")
    else
      # No upstream configured — first push of a new branch. Scan
      # every tracked file to be safe; secretlint is fast.
      files=$(git ls-files -z)
    fi
    if [ -z "$files" ]; then
      exit 0
    fi
    # `xargs -0` is POSIX-portable enough for macOS BSD + GNU.
    printf '%s' "$files" | xargs -0 pnpm exec secretlint --
    """#
  cache = false
  // Re-run when the secretlint config changes; not strictly
  // necessary because cache is off, but lets `pkf run --print-hash`
  // surface the config dependency.
  inputs {
    ".secretlintrc.json"
    ".secretlintignore"
    "package.json"
    "pnpm-lock.yaml"
  }
}

/// Hook target. `pkf hooks install` wires `.git/hooks/pre-push` to
/// this. Kept as a thin aggregator so you can add more gates later
/// (tests, build verification, ...) without touching the hooks
/// installation.
local prePush: Task = new {
  name = "pre-push"
  description = "Pre-push gate: secretlint over the outgoing diff"
  cmd = "echo pre-push ok"
  cache = false
  deps { secretlint }
}

tasks { secretlint; prePush }

// ---------------------------------------------------------------
// Adding more gates later
// ---------------------------------------------------------------
//
// As the project grows, add sibling tasks and chain them into
// pre-push's deps. Example: full test suite as part of the push gate.
//
//   local fullTest = new Task {
//     name = "test:full"
//     cmd  = "pnpm exec vitest run"
//     inputs { "src/**/*.{ts,tsx}"; "test/**/*.{ts,tsx}" }
//   }
//   local prePush = new Task {
//     name = "pre-push"; cmd = "echo pre-push ok"; cache = false
//     deps { secretlint; fullTest }
//   }
//
// `pkf hooks install` is idempotent — re-running it after adding
// new hook tasks just updates the shim mapping.
