examples {
  ["minimal build task"] {
    new {
      name = "build"
      cmd = "go build ./..."
      shell = "bash"
      shellFlags = List("-c")
      inputs {
        "**/*.go"
        "go.mod"
      }
      outputs {
        "bin/pkf"
      }
      deps {}
      env {}
      tools {}
      cache = true
      workdir = null
      description = null
      visibility = "public"
      quiet = false
      service = false
      shutdownTimeoutSeconds = 5
      services {}
      readyPort = 0
      readyCmd = ""
      readyTimeoutSeconds = 30
      inheritEnv = true
      acceptsArgs = false
      params {}
    }
  }
}
