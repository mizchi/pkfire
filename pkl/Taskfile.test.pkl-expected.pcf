examples {
  ["minimal build task"] {
    new {
      name = "build"
      cmd = "go build ./..."
      shell = "bash"
      inputs {
        "**/*.go"
        "go.mod"
      }
      outputs {
        "bin/pkf"
      }
      deps {}
      env {}
      tools {}
      cache = true
      workdir = null
      description = null
      service = false
      shutdownTimeoutSeconds = 5
      services {}
      readyPort = 0
      readyCmd = ""
      readyTimeoutSeconds = 30
    }
  }
}
