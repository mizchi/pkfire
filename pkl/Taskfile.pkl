/// pkfire Taskfile schema (A2: typed DAG).
///
/// Authoring model:
///   - Each task is a `Task` instance with a unique `name` and direct
///     `deps` references to other Task instances. Typos in dependency
///     names become Pkl name-resolution errors at evaluation time.
///   - `tasks: Listing<Task>` collects the authored tasks; the order is
///     informational. The execution order is the topological sort over
///     `deps`, computed by `pkf` at runtime.
///
/// Wire format:
///   - `output.value` is a Mapping<String, RenderedTask> keyed by task
///     name, with `deps` collapsed to a list of names. This is what the
///     Go runner deserializes — keeping the wire shape identical to
///     earlier phases so the runner did not need a decoder change.
///   - Duplicate names raise an error before output is rendered.
@ModuleInfo { minPklVersion = "0.31.0" }
open module pkfire.Taskfile

/// A unit of work authored by the user.
class Task {
  /// Identifier. Used as the Mapping key in the rendered output and as
  /// the visible name in `pkf list` / `pkf graph`.
  name: String(matches(Regex(#"^[a-zA-Z][a-zA-Z0-9_:.-]*$"#)))

  /// Shell command to execute. Run via `<shell> -c <cmd>`.
  cmd: String(length > 0)

  /// Shell binary used to run `cmd`. Defaults to `bash`.
  shell: String = "bash"

  /// Glob patterns of input files. Their content hash feeds the action key.
  ///
  /// Patterns support `*`, `**`, `?`, and character classes via doublestar.
  /// Literal paths that do not exist are *silently ignored* (matched 0 times),
  /// which means a missing file does NOT raise an error — it just contributes
  /// nothing to the action key. Use `pkf run --print-hash` if you need to
  /// confirm exactly which files end up hashed.
  inputs: Listing<String> = new {}

  /// Files or directories produced by this task. Restored on cache hit.
  ///
  /// Paths are relative to `workdir` (or the Taskfile's directory when
  /// `workdir` is null). *Parent directories are not auto-created* — if
  /// your `cmd` writes to `bin/app`, prefix it with `mkdir -p bin && ...`
  /// or use a tool that creates the directory itself (e.g. `go build -o`).
  outputs: Listing<String> = new {}

  /// Dependencies as direct Task references. The Pkl evaluator resolves
  /// each entry to a concrete Task value, so referencing an undefined
  /// task fails at evaluation time (`Cannot find property`).
  deps: Listing<Task> = new {}

  /// Environment variables exposed to `cmd`. Only these contribute to the
  /// action key — the ambient environment is intentionally ignored.
  env: Mapping<String, String> = new {}

  /// External tools whose version should be part of the action key
  /// (e.g. "go" -> "1.26.2"). Typically populated from mise / `which`.
  tools: Mapping<String, String> = new {}

  /// When false, the task always runs and its result is never cached.
  cache: Boolean = true

  /// Working directory relative to repo root. Null means repo root.
  workdir: String? = null

  /// Free-form description shown by `pkf list`.
  description: String? = null

  /// When true, this task is a long-running service. It is started by
  /// `pkf up` and supervised until the up session ends (Ctrl+C or a
  /// watch-driven restart). Implies `cache = false` at runtime — the
  /// runner ignores any cache setting on a service. `pkf run` rejects
  /// any plan that contains a service task; use `pkf up` instead.
  service: Boolean = false

  /// Seconds to wait between SIGTERM and SIGKILL when stopping a
  /// service. Only applied when `service` is true. The runner sets
  /// the cmd as a process-group leader so the whole subtree (e.g.
  /// `bash -c "node server.js"` ⇒ bash + node) is signalled.
  shutdownTimeoutSeconds: Int(this >= 0) = 5

  /// Sibling tasks that must be running while this task's `cmd`
  /// executes. Each entry must itself be `service: true`. `pkf run`
  /// starts the listed services (in declared order) before invoking
  /// `cmd`, then stops them with the same SIGTERM-then-SIGKILL flow
  /// once `cmd` finishes — pass or fail. Cache lookups happen *before*
  /// services are started, so a cache hit never spawns a server.
  ///
  /// Typical use: end-to-end tests (`services { api; db }`) or
  /// scripts that need a real database to run against.
  services: Listing<Task> = new {}
}

/// Project-level defaults shared by all tasks unless overridden.
class Defaults {
  shell: String = "bash"
  env: Mapping<String, String> = new {}
}

/// Wire format consumed by the Go runner. `name` is lifted to the Mapping
/// key in `Rendered.tasks`; `deps` is projected from `Listing<Task>` to
/// `Listing<String>` so the runner can deserialize without recursion.
class RenderedTask {
  cmd: String
  shell: String
  inputs: Listing<String>
  outputs: Listing<String>
  deps: Listing<String>
  env: Mapping<String, String>
  tools: Mapping<String, String>
  cache: Boolean
  workdir: String?
  description: String?
  service: Boolean
  shutdownTimeoutSeconds: Int
  services: Listing<String>
}

/// Top-level shape of `output.value`. pkl-go's `EvaluateOutputValue` looks
/// up the Go target type via `pkl.RegisterMapping("pkfire.Taskfile#Rendered", ...)`.
class Rendered {
  defaults: Defaults
  tasks: Mapping<String, RenderedTask>
}

defaults: Defaults = new {}

/// Authored task list. In user modules, declare each task as a `local`
/// binding and add it here:
///
///     local build = new Task { name = "build"; cmd = "go build" }
///     local test  = new Task { name = "test"; cmd = "go test"; deps { build } }
///     tasks { build; test }
///
/// **Forgetting to add a declared `local` to this listing is the most
/// common pitfall.** Pkl's `amends` semantics intentionally forbid adding
/// new top-level fields, so reflect-based auto-collection is not viable;
/// each task must be listed explicitly. Duplicate names in the listing
/// raise an error before output is rendered (see `output.value` below).
tasks: Listing<Task> = new {}

local taskNames: List<String> = tasks.toList().map((t) -> t.name)

local duplicateNames: List<String> = taskNames
  .filter((n) -> taskNames.count((m) -> m == n) > 1)
  .distinct

local rendered: Mapping<String, RenderedTask> = new Mapping {
  for (t in tasks) {
    [t.name] = new RenderedTask {
      cmd = t.cmd
      shell = t.shell
      inputs = t.inputs
      outputs = t.outputs
      deps = new Listing { for (d in t.deps) { d.name } }
      env = t.env
      tools = t.tools
      cache = t.cache
      workdir = t.workdir
      description = t.description
      service = t.service
      shutdownTimeoutSeconds = t.shutdownTimeoutSeconds
      services = new Listing { for (s in t.services) { s.name } }
    }
  }
}

output {
  value = new Rendered {
    defaults = module.defaults
    tasks = if (duplicateNames.isEmpty) rendered
      else throw("duplicate task names: \(duplicateNames.join(", "))")
  }
}
