/// Schema-level tests for `Taskfile.pkl`.
///
/// Run with: `pkl test pkl/Taskfile.test.pkl`
amends "pkl:test"

import "Taskfile.pkl" as Schema

local build: Schema.Task = new {
  name = "build"
  cmd = "go build ./..."
  inputs { "**/*.go"; "go.mod" }
  outputs { "bin/pkf" }
}

local test: Schema.Task = new {
  name = "test"
  cmd = "go test ./..."
  inputs { "**/*.go" }
  deps { build }
}

facts {
  ["task names match what was authored"] {
    build.name == "build"
    test.name == "test"
  }

  ["defaults: cache is enabled"] {
    build.cache == true
  }

  ["defaults: shell is bash"] {
    build.shell == "bash"
  }

  ["defaults: shellFlags is -c"] {
    build.shellFlags == List("-c")
  }

  ["shellFlags round-trips"] {
    (
      new Schema.Task {
        name = "node"
        shell = "node"
        shellFlags = List("-e")
        cmd = "console.log(1)"
      }
    ).shellFlags == List("-e")
  }

  ["defaults: service is false"] {
    build.service == false
  }

  ["defaults: shutdownTimeoutSeconds is 5"] {
    build.shutdownTimeoutSeconds == 5
  }

  ["service flag round-trips"] {
    (new Schema.Task { name = "dev"; cmd = "node server.js"; service = true }).service == true
  }

  ["services field round-trips Task references"] {
    let (api = new Schema.Task { name = "api"; cmd = "exec node server.js"; service = true })
    let (e2e = new Schema.Task { name = "e2e"; cmd = "vitest"; cache = false; services { api } })
      e2e.services.toList().first.name == "api"
  }

  ["readyPort defaults to 0 (no probe)"] {
    build.readyPort == 0
  }

  ["readyPort accepts a valid TCP port"] {
    (new Schema.Task { name = "db"; cmd = "postgres"; service = true; readyPort = 5432 }).readyPort
      == 5432
  }

  ["readyPort rejects values outside the TCP range"] {
    module.catch(() -> (new Schema.Task { name = "x"; cmd = "y"; readyPort = 99999 }).readyPort)
      != null
  }

  ["negative shutdownTimeoutSeconds is rejected"] {
    module.catch(() ->
      (new Schema.Task { name = "x"; cmd = "y"; shutdownTimeoutSeconds = -1 })
        .shutdownTimeoutSeconds
    ) != null
  }

  ["deps reference returns the same Task instance"] {
    test.deps.toList().first.name == "build"
  }

  ["cmd can be omitted for deps-only umbrella tasks"] {
    (new Schema.Task { name = "ci"; deps { build } }).cmd == null
  }

  ["empty cmd is rejected"] {
    module.catch(() -> (new Schema.Task { name = "x"; cmd = "" }).cmd) != null
  }

  ["bad name characters are rejected"] {
    module.catch(() -> (new Schema.Task { name = "has space"; cmd = "x" }).name) != null
    module.catch(() -> (new Schema.Task { name = "1leading-digit"; cmd = "x" }).name) != null
  }

  ["name allows forward slash"] {
    (new Schema.Task { name = "check-translate/docs"; cmd = "x" }).name == "check-translate/docs"
  }

  ["inheritEnv defaults to true"] {
    build.inheritEnv == true
  }

  ["inheritEnv can be turned off"] {
    (new Schema.Task { name = "hermetic"; cmd = "x"; inheritEnv = false }).inheritEnv == false
  }

  ["acceptsArgs defaults to false"] {
    build.acceptsArgs == false
  }

  ["acceptsArgs round-trips"] {
    (new Schema.Task { name = "run"; cmd = "node \"$@\""; acceptsArgs = true }).acceptsArgs == true
  }

  ["visibility defaults to public"] {
    build.visibility == "public"
  }

  ["quiet defaults to false"] {
    build.quiet == false
  }

  ["quiet can be enabled"] {
    (new Schema.Task { name = "wrapper"; cmd = "echo wrapper"; quiet = true }).quiet == true
  }

  ["visibility can be internal"] {
    (new Schema.Task { name = "helper"; cmd = "echo helper"; visibility = "internal" }).visibility
      == "internal"
  }

  ["unknown visibility is rejected"] {
    module.catch(() -> (new Schema.Task { name = "x"; cmd = "y"; visibility = "hidden" }).visibility)
      != null
  }

  ["params defaults to empty"] {
    build.params.toList().isEmpty
  }

  ["enum param round-trips"] {
    let (
      p = new Schema.Param {
        name = "bump"
        type = "enum"
        choices { "patch"; "minor"; "major" }
        default = "patch"
      }
    )
    let (t = new Schema.Task { name = "bump-version"; cmd = "echo $BUMP"; params { p } })
      t.params.toList().first.name == "bump"
  }

  ["param name with uppercase is rejected"] {
    module.catch(() -> (new Schema.Param { name = "Bump"; type = "string" }).name) != null
  }

  ["param name with hyphen is rejected"] {
    module.catch(() -> (new Schema.Param { name = "bump-target"; type = "string" }).name) != null
  }

  ["int param round-trips"] {
    (new Schema.Param { name = "count"; type = "int"; default = "1" }).type == "int"
  }

  ["bool param round-trips"] {
    (new Schema.Param { name = "watch"; type = "bool"; default = "false" }).type == "bool"
  }

  ["unknown param type is rejected"] {
    module.catch(() -> (new Schema.Param { name = "x"; type = "float" }).type) != null
  }

  ["workflow test round-trips changed files, direct tasks, and plan"] {
    let (
      wt = new Schema.WorkflowTest {
        name = "go source"
        changed { "src/main.go" }
        direct { "build" }
        tasks { "build"; "test" }
      }
    )
      wt.changed.toList().first == "src/main.go"
        && wt.direct.toList().first == "build"
        && wt.tasks.toList().last == "test"
  }
}

examples {
  ["minimal build task"] {
    build
  }
}
