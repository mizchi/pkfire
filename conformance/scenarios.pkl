amends "Conformance.pkl"

scenarios {
  new {
    id = "list-json-basic"
    fixture = "examples/basic"
    argv { "list"; "--json" }
    contract = new {
      json = true
    }
  }
  new {
    id = "no-taskfile-error"
    fixture = "examples/empty-dir"
    argv { "list" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr { "pkf:" }
    }
  }
  new {
    id = "version"
    fixture = "examples/basic"
    argv { "version" }
    contract = new { exit = true; stdoutNonEmpty = true }
  }
  new {
    id = "help"
    fixture = "examples/basic"
    argv { "help" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "run" } }
  }
  new {
    id = "no-args"
    fixture = "examples/basic"
    argv {}
    contract = new { exit = true; stdoutNonEmpty = true }
  }
  new {
    id = "unknown-subcommand"
    fixture = "examples/basic"
    argv { "bogus" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "run" } }
  }
  new {
    id = "list-from-subdir"
    fixture = "examples/basic"
    argv { "list" }
    env { ["PKF_CONFORMANCE_SUBDIR"] = "sub" }
    setup { "mkdir -p sub" }
    contract = new { exit = true; mustContain { "hello" } }
  }
  new {
    id = "list-file-flag"
    fixture = "examples/basic"
    argv { "list"; "--file=Taskfile.pkl" }
    contract = new { exit = true; mustContain { "hello" } }
  }
  new {
    id = "run-output-from-subdir"
    fixture = "examples/cat-io"
    argv { "run"; "copy" }
    env { ["PKF_CONFORMANCE_SUBDIR"] = "sub" }
    setup { "mkdir -p sub"; "printf hi > src.txt" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "graph-json-basic"
    fixture = "examples/basic"
    argv { "graph"; "--json" }
    contract = new {
      json = true
      unorderedPaths { "edges" }
    }
  }
  new {
    id = "graph-json-kinds"
    fixture = "examples/graph-kinds"
    argv { "graph"; "--json" }
    contract = new { json = true; unorderedPaths { "edges" } }
  }
  new {
    id = "graph-json-kinds-all"
    fixture = "examples/graph-kinds"
    argv { "graph"; "--json"; "--all" }
    contract = new { json = true; unorderedPaths { "edges" } }
  }
  new {
    id = "describe-json-rich"
    fixture = "examples/describe-rich"
    argv { "describe"; "--json"; "deploy" }
    contract = new { json = true }
  }
  new {
    id = "describe-json-deps"
    fixture = "examples/describe-rich"
    argv { "describe"; "--json"; "app" }
    contract = new { json = true }
  }
  new {
    id = "describe-unknown"
    fixture = "examples/basic"
    argv { "describe"; "nope" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "unknown task" } }
  }
  new {
    id = "info-json-basic"
    fixture = "examples/basic"
    argv { "info"; "--json" }
    contract = new { json = true; jsonIgnorePaths { "taskfile" } }
  }
  new { id = "list-json-rich"; fixture = "examples/describe-rich"; argv { "list"; "--json" }; contract = new { json = true } }
  new { id = "info-json-rich"; fixture = "examples/describe-rich"; argv { "info"; "--json" }; contract = new { json = true; jsonIgnorePaths { "taskfile" } } }
  new { id = "describe-arg-after-json"; fixture = "examples/describe-rich"; argv { "describe"; "deploy"; "--json" }; contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "single task name" } } }
  new { id = "completion-bash"; fixture = "examples/basic"; argv { "completion"; "bash" }; contract = new { exit = true; stdoutNonEmpty = true; mustContain { "pkf bash completion" } } }
  new { id = "completion-zsh"; fixture = "examples/basic"; argv { "completion"; "zsh" }; contract = new { exit = true; stdoutNonEmpty = true; mustContain { "#compdef pkf" } } }
  new { id = "completion-fish"; fixture = "examples/basic"; argv { "completion"; "fish" }; contract = new { exit = true; stdoutNonEmpty = true; mustContain { "complete -c pkf" } } }
  new { id = "lint-clean"; fixture = "examples/basic"; argv { "lint"; "--json" }; contract = new { json = true } }
  new { id = "lint-dead"; fixture = "examples/lint-dead"; argv { "lint"; "--json" }; contract = new { json = true; exit = true; jsonIgnorePaths { "path" } } }
  new {
    id = "doctor-structural"
    fixture = "examples/basic"
    argv { "doctor"; "--json" }
    contract = new {
      exit = true
      mustContain { "checks"; "level"; "label"; "message"; "pkl"; "cache"; "remote"; "taskfile"; "pkf-path" }
    }
  }
  new {
    id = "explain-structural"
    fixture = "examples/basic"
    argv { "explain"; "build" }
    contract = new {
      exit = true
      mustContain { "task:"; "action key:"; "cmd:"; "shell:"; "input patterns" }
    }
  }
}
