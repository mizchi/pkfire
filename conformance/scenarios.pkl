amends "Conformance.pkl"

scenarios {
  new {
    id = "list-json-basic"
    fixture = "examples/basic"
    argv { "list"; "--json" }
    contract = new {
      json = true
    }
  }
  new {
    id = "no-taskfile-error"
    fixture = "examples/empty-dir"
    argv { "list" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr { "pkf:" }
    }
  }
  new {
    id = "version"
    fixture = "examples/basic"
    argv { "version" }
    contract = new { exit = true; stdoutNonEmpty = true }
  }
  new {
    id = "help"
    fixture = "examples/basic"
    argv { "help" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "run" } }
  }
  new {
    id = "no-args"
    fixture = "examples/basic"
    argv {}
    contract = new { exit = true; stdoutNonEmpty = true }
  }
  new {
    id = "unknown-subcommand"
    fixture = "examples/basic"
    argv { "bogus" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "run" } }
  }
  new {
    id = "list-from-subdir"
    fixture = "examples/basic"
    argv { "list" }
    env { ["PKF_CONFORMANCE_SUBDIR"] = "sub" }
    setup { "mkdir -p sub" }
    contract = new { exit = true; mustContain { "hello" } }
  }
  new {
    id = "list-file-flag"
    fixture = "examples/basic"
    argv { "list"; "--file=Taskfile.pkl" }
    contract = new { exit = true; mustContain { "hello" } }
  }
  new {
    id = "run-output-from-subdir"
    fixture = "examples/cat-io"
    argv { "run"; "copy" }
    env { ["PKF_CONFORMANCE_SUBDIR"] = "sub" }
    setup { "mkdir -p sub"; "printf hi > src.txt" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "graph-json-basic"
    fixture = "examples/basic"
    argv { "graph"; "--json" }
    contract = new {
      json = true
      unorderedPaths { "edges" }
    }
  }
  new {
    id = "graph-json-kinds"
    fixture = "examples/graph-kinds"
    argv { "graph"; "--json" }
    contract = new { json = true; unorderedPaths { "edges" } }
  }
  new {
    id = "graph-json-kinds-all"
    fixture = "examples/graph-kinds"
    argv { "graph"; "--json"; "--all" }
    contract = new { json = true; unorderedPaths { "edges" } }
  }
  new {
    id = "describe-json-rich"
    fixture = "examples/describe-rich"
    argv { "describe"; "--json"; "deploy" }
    contract = new { json = true }
  }
  new {
    id = "describe-json-deps"
    fixture = "examples/describe-rich"
    argv { "describe"; "--json"; "app" }
    contract = new { json = true }
  }
  new {
    id = "describe-unknown"
    fixture = "examples/basic"
    argv { "describe"; "nope" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "unknown task" } }
  }
  new {
    id = "info-json-basic"
    fixture = "examples/basic"
    argv { "info"; "--json" }
    contract = new { json = true; jsonIgnorePaths { "taskfile" } }
  }
  new {
    id = "list-json-rich"
    fixture = "examples/describe-rich"
    argv { "list"; "--json" }
    contract = new { json = true }
  }
  new {
    id = "info-json-rich"
    fixture = "examples/describe-rich"
    argv { "info"; "--json" }
    contract = new { json = true; jsonIgnorePaths { "taskfile" } }
  }
  new {
    id = "describe-arg-after-json"
    fixture = "examples/describe-rich"
    argv { "describe"; "deploy"; "--json" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "single task name" } }
  }
  new {
    id = "completion-bash"
    fixture = "examples/basic"
    argv { "completion"; "bash" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "pkf bash completion" } }
  }
  new {
    id = "completion-zsh"
    fixture = "examples/basic"
    argv { "completion"; "zsh" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "#compdef pkf" } }
  }
  new {
    id = "completion-fish"
    fixture = "examples/basic"
    argv { "completion"; "fish" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "complete -c pkf" } }
  }
  new {
    id = "lint-clean"
    fixture = "examples/basic"
    argv { "lint"; "--json" }
    contract = new { json = true }
  }
  new {
    id = "lint-dead"
    fixture = "examples/lint-dead"
    argv { "lint"; "--json" }
    contract = new { json = true; exit = true; jsonIgnorePaths { "path" } }
  }
  new {
    id = "lint-rules"
    fixture = "examples/lint-rules"
    argv { "lint"; "--json" }
    contract = new { json = true; exit = true; jsonIgnorePaths { "path" } }
  }
  new {
    id = "artifact-order"
    fixture = "examples/artifact-order"
    // Consumer first, on purpose: the only thing that can put `gen`
    // ahead of `consume` is the edge analysis derives from the fact
    // that `consume` reads what `gen` declares as output. Lose that
    // edge and `out.txt` does not exist yet, so the substring below
    // is `consume read` with nothing after it.
    argv { "run"; "consume"; "gen" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new { exit = true; mustContain { "consume read artifact" } }
  }
  new {
    id = "parallel-order"
    fixture = "examples/artifact-order"
    // Same fixture as `artifact-order`, run with four jobs. The graph's
    // edges have to survive being scheduled concurrently: lose them and
    // `consume` starts before `out.txt` exists, so the substring below
    // is `consume read` with nothing after it.
    argv { "run"; "-j"; "4"; "consume"; "gen" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new { exit = true; mustContain { "consume read artifact" } }
  }
  new {
    id = "keep-going-skips-dependents"
    fixture = "examples/keep-going"
    // Continuing past a failure must not mean running its dependents
    // against inputs that were never produced. `other` is independent
    // and still runs; `after` and the umbrella above it are skipped,
    // and the run still exits non-zero.
    argv { "run"; "--keep-going"; "all" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      mustContain {
        "bad ran"
        "other ran"
        "after (skipped: `bad` failed)"
        "all (skipped: `bad` failed)"
      }
    }
  }
  new {
    id = "lint-string-safe"
    fixture = "examples/lint-string-safe"
    argv { "lint"; "--json" }
    contract = new { json = true; exit = true; jsonIgnorePaths { "path" } }
  }
  new {
    id = "lint-watch-cycle"
    fixture = "examples/lint-watch-cycle"
    argv { "lint"; "--json" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new { json = true; exit = true; jsonIgnorePaths { "path" } }
  }
  new {
    id = "doctor-structural"
    fixture = "examples/basic"
    argv { "doctor"; "--json" }
    contract = new {
      exit = true
      mustContain {
        "checks"
        "level"
        "label"
        "message"
        "pkl"
        "cache"
        "remote"
        "taskfile"
        "pkf-path"
      }
    }
  }
  new {
    id = "explain-structural"
    fixture = "examples/basic"
    argv { "explain"; "build" }
    contract = new {
      exit = true
      mustContain { "task:"; "action key:"; "cmd:"; "shell:"; "input patterns" }
    }
  }
  new {
    id = "init-writes"
    fixture = "examples/empty-dir"
    argv { "init" }
    contract = new { exit = true; fsDelta = true; mustContainStderr { "wrote Taskfile.pkl" } }
  }
  new {
    id = "format-rewrites"
    fixture = "examples/unformatted"
    argv { "format" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "migrate-rewrites"
    fixture = "examples/migrate-src"
    argv { "migrate"; "--to=0.11.0"; "--skip-verify" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "migrate-dry-run"
    fixture = "examples/migrate-src"
    argv { "migrate"; "--to=0.11.0"; "--dry-run" }
    contract = new { exit = true; mustContain { "0.11.0" } }
  }
  new {
    id = "hooks-install"
    fixture = "examples/hooks-tf"
    argv { "hooks"; "install" }
    setup { "git init -q" }
    contract = new {
      exit = true
      fsDelta = true
      mustContain { "pre-commit" }
      mustContainStderr { "cache=true" }
    }
  }
  // A git-hook-named task must tolerate the positional args git hands
  // its hook scripts (`pkf hooks install` writes `pkf run <event> --
  // "$@"`, and e.g. pre-push gets `<remote> <url>`). The task here sets
  // no acceptsArgs, so this also pins that hook events are exempt from
  // the positional-args guard while the args stay ignored by the cmd.
  new {
    id = "run-hook-task-with-git-args"
    fixture = "examples/hooks-tf"
    argv { "run"; "pre-push"; "--"; "origin"; "https://example.com/repo.git" }
    contract = new { exit = true; mustContain { "running pre-push" } }
  }
  new {
    id = "trace-check-undeclared"
    fixture = "examples/trace-inputs"
    argv { "trace"; "--check"; "bundle" }
    contract = new {
      exit = true
      mustContain {
        "read but not covered"
        "conf/settings.ini"
      }
    }
  }
  new {
    id = "clean-removes-outputs"
    fixture = "examples/cat-io"
    argv { "clean" }
    setup { "printf hi > src.txt"; "printf out > out.txt" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "sandbox-undeclared-read"
    fixture = "examples/sandbox"
    // `sneaky` reads a file it never declared. Unsandboxed it succeeds
    // and caches; the empty fsDelta is the other half of the
    // assertion — a failed sandboxed action leaves the workspace
    // exactly as it found it.
    argv { "run"; "--no-cache"; "--sandbox"; "sneaky" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      fsDelta = true
      mustContainStderr { "No such file or directory" }
    }
  }
  new {
    id = "sandbox-undeclared-write"
    fixture = "examples/sandbox"
    // `messy` writes `dist/scratch.log` without declaring it. The
    // declared output comes back; the undeclared one is reported and
    // stays in the sandbox, so fsDelta names only `dist/messy.txt`.
    argv { "run"; "--no-cache"; "--sandbox"; "messy" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      fsDelta = true
      mustContainStderr {
        "it did not declare as outputs"
        "dist/scratch.log"
      }
    }
  }
  new {
    id = "graph-dot"
    fixture = "examples/artifact-order"
    // The README documented `pkf graph | dot -Tsvg` for a command that
    // printed a tree, so the pipeline could not have worked. The
    // dashed edge is the other half: `consume` reads what `gen`
    // declares as output, and a diagram showing only `deps` would draw
    // no arrow between them at all.
    argv { "graph"; "--format"; "dot" }
    contract = new {
      exit = true
      mustContain {
        "digraph pkfire {"
        "style=dashed"
        "out.txt"
      }
    }
  }
  new {
    id = "graph-mermaid"
    fixture = "examples/artifact-order"
    argv { "graph"; "--format=mermaid" }
    contract = new {
      exit = true
      mustContain { "flowchart LR"; ".-> "; "out.txt" }
    }
  }
  new {
    id = "graph-unknown-format"
    fixture = "examples/basic"
    argv { "graph"; "--format"; "svg" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr { "unknown format" }
    }
  }
  new {
    id = "cache-hit-skips-command"
    fixture = "examples/cache-hit"
    // `setup` performs the first run, so the scenario's own run is the
    // second one. `count` appends to `runs.log`, which it never
    // declares as an output — so the cache neither stores nor restores
    // it, and an empty fsDelta is proof the command did not run again.
    // Reporting a hit is easy; skipping the work is the contract.
    setup { "\"$PKF_MBT_BIN\" run count" }
    argv { "run"; "count" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      fsDelta = true
      mustContain { "cache hit" }
    }
  }
  new {
    id = "cache-hit-replays-logs"
    fixture = "examples/cache-hit"
    // `setup` runs `say` once, so the scenario's run is the hit. The
    // command is not re-executed, so every line of output here came out
    // of the cache entry — which is the whole assertion: a build's
    // transcript must not depend on whether the cache was warm.
    setup { "\"$PKF_MBT_BIN\" run say" }
    argv { "run"; "say" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      mustContain { "replaying logs"; "built the thing" }
      mustContainStderr { "a warning" }
    }
  }
  new {
    id = "cache-hit-of-a-silent-task-says-nothing-about-logs"
    fixture = "examples/cache-hit"
    // `count` prints nothing, so there is nothing to replay and the hit
    // line must not claim otherwise — a `replaying logs` on every
    // silent task in a fifty-task build is noise, not information.
    setup { "\"$PKF_MBT_BIN\" run count" }
    argv { "run"; "count" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new { exit = true; mustContain { "cache hit" } }
  }
  new {
    id = "execution-log-records-what-ran"
    fixture = "examples/execution-log"
    // `setup` performs the run that writes the log; the scenario's own
    // run reads it back and asserts every field a consumer parses.
    // Checking from inside a task rather than from the harness is the
    // point: the assertions read the file the way a dashboard would, so
    // a renamed field fails here rather than downstream.
    setup { "\"$PKF_MBT_BIN\" run pack --execution-log=run.jsonl" }
    argv { "run"; "check-log" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      mustContain { "execution log ok" }
    }
  }
  new {
    id = "execution-log-records-a-cached-run-as-cached"
    fixture = "examples/execution-log"
    // The second run hits, so nothing executes. A log that reported it
    // as work would be exactly wrong for the question it exists to
    // answer, and an `exitCode` on a hit reads as "ran and succeeded".
    setup {
      "\"$PKF_MBT_BIN\" run pack"
      "\"$PKF_MBT_BIN\" run pack --execution-log=cached.jsonl"
    }
    argv { "run"; "check-cached" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      mustContain { "cached log ok" }
    }
  }
  new {
    id = "cas-shares-unchanged-outputs-between-entries"
    fixture = "examples/cas-share"
    // Two runs, one edited input, so two action keys covering four
    // declared outputs. Three blobs, not four: the output that did not
    // change is stored once. The old single-archive layout stored both
    // outputs twice, which is the whole reason the entry was split.
    setup {
      "\"$PKF_MBT_BIN\" run build"
      "printf 'two\\n' > src/changing.txt"
      "\"$PKF_MBT_BIN\" run build"
    }
    argv { "run"; "check-store" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      mustContain { "store shares blobs" }
    }
  }
  new {
    id = "a-pre-split-entry-is-still-a-hit"
    fixture = "examples/cas-share"
    // An upgrade that silently emptied a warm cache would cost every
    // user a full rebuild, so the old single-archive layout is still
    // read. The setup plants one by hand under the key the runner will
    // ask for, with contents no run of this task could produce — so a
    // hit proves the entry came from there and not from re-executing.
    setup {
      """
      key=$("$PKF_MBT_BIN" run build --print-hash | awk '$2 == "build" { print $1 }')
      mkdir -p stage/dist
      echo FROM-A-PRE-SPLIT-ENTRY > stage/dist/changing.txt
      echo FROM-A-PRE-SPLIT-ENTRY > stage/dist/stable.txt
      mkdir -p ".pkf-cache/cas/${key:0:2}/${key:2}"
      tar czf ".pkf-cache/cas/${key:0:2}/${key:2}/entry.tar.gz" -C stage dist
      rm -rf stage
      """
    }
    argv { "run"; "build" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      mustContain { "cache hit" }
      fsDelta = true
    }
  }
  new {
    id = "reserved-output-prefix-is-refused"
    fixture = "examples/reserved-output"
    // `.pkf-meta/` is where an entry keeps the captured logs. A task
    // declaring an output there would have it stored and then dropped
    // on restore, so the file would exist after the run that made it
    // and vanish on every hit — a bug that only appears once the cache
    // is warm. The Taskfile is refused instead.
    argv { "run"; "bad" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr { "reserved for pkfire" }
    }
  }
  new {
    id = "steps-rebuild-only-what-changed"
    fixture = "examples/steps"
    // The property that makes steps worth having, asserted by what is
    // *not* re-run. A pipeline written as one `&&` chain would re-run
    // all of it and still look fine, so the cache-hit line on `codegen`
    // is the whole test.
    setup {
      "\"$PKF_MBT_BIN\" run bundle > /dev/null"
      "printf 'src-v2\\n' > src/main.txt"
    }
    argv { "run"; "bundle" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      mustContain { "# bundle/codegen (cache hit"; "$ bundle/compile"; "$ bundle/link" }
    }
  }
  new {
    id = "a-step-is-runnable-by-its-composed-name"
    fixture = "examples/steps"
    // `<task>/<step>` is what every message calls a step, so it has to
    // be a name you can type.
    argv { "run"; "bundle/codegen" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new { exit = true; mustContain { "codegen ran" } }
  }
  new {
    id = "a-provider-resolves-into-the-consumers-workdir"
    fixture = "examples/providers"
    // `cli` writes under `crates/cli`; `smoke` runs from `apps/web`.
    // The path that works from there is the walk between the two, which
    // is the value a Taskfile author cannot write correctly by hand.
    argv { "explain"; "smoke" }
    contract = new {
      exit = true
      mustContain {
        "PKF_CLI_EXECUTABLE=../../crates/cli/target/cli"
        "CLI_CHANNEL=stable"
      }
    }
  }
  new {
    id = "the-target-platform-selects-the-toolchain"
    fixture = "examples/cross"
    // One `cc` declaration resolving to two compilers. `explain` names
    // both halves because "the Taskfile says cc, so which compiler was
    // that?" is the question a cross-compile makes you ask.
    setup { "chmod +x bin/cc bin/aarch64-linux-gnu-gcc" }
    argv { "explain"; "cross" }
    env { ["PATH"] = "./bin:/usr/bin:/bin" }
    contract = new {
      exit = true
      mustContain { "cc -> aarch64-linux-gnu-gcc" }
    }
  }
  new {
    id = "a-timeout-stops-the-script-it-killed"
    fixture = "examples/timeout"
    // Two assertions. The exit code says the deadline fired; the
    // *absence* of "after the sleep" says the shell died with its child
    // rather than carrying on to the next line — which is what a
    // teardown that signals the child first actually does.
    argv { "run"; "hang" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new {
      exit = true
      mustContain { "before the sleep" }
      mustContainStderr { "exceeded its 2s timeout" }
    }
  }
  new {
    id = "a-task-this-machine-cannot-run-says-so"
    fixture = "examples/timeout"
    // Refused before the command is spawned, so the message names the
    // task and the requirement instead of surfacing as whatever the
    // first platform-specific tool in the script happens to print.
    argv { "run"; "elsewhere" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr { "requires execution platform plan9/vax" }
    }
  }
  new {
    id = "shorthand-runs-a-task-without-run"
    fixture = "examples/basic"
    // `pkf hello` is `pkf run hello`. Typing `run` for the thing this
    // tool mostly does is ceremony every comparable runner drops.
    argv { "hello" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new { exit = true; mustContain { "hello from pkfire" } }
  }
  new {
    id = "shorthand-does-not-shadow-a-builtin"
    fixture = "examples/shadowed"
    // The fixture declares a task called `list`. `pkf list` must stay
    // the subcommand: a command whose meaning depends on the repository
    // it runs in is one nobody can learn. The task's own output must
    // not appear.
    argv { "list" }
    contract = new {
      exit = true
      mustContain { "shadow-me" }
    }
  }
  new {
    id = "a-shadowed-task-is-reported-by-lint"
    fixture = "examples/shadowed"
    // Losing the shorthand is a real surprise, so it is said at lint
    // time rather than the first time someone types `pkf list` and gets
    // the wrong thing.
    argv { "lint" }
    contract = new {
      exit = true
      mustContain { "shadowed-by-builtin"; "pkf run list" }
    }
  }
  new {
    id = "an-unknown-name-names-both-possibilities"
    fixture = "examples/basic"
    // `pkf helo` could be a typo for either a subcommand or a task, and
    // the message cannot know which — so it offers the near misses it
    // has rather than guessing.
    argv { "helo" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr { "unknown subcommand or task `helo`"; "hello" }
    }
  }
  new {
    id = "eval-cache-sees-an-edited-taskfile"
    fixture = "examples/eval-cache"
    // `setup` warms the evaluation cache and then edits the Taskfile,
    // so the measured run is a lookup whose entry is no longer true.
    // A cached plan that survived this would run yesterday's commands
    // and report success, with nothing in the output to say so.
    setup {
      "\"$PKF_MBT_BIN\" list > /dev/null"
      "sed -i.bak 's/echo building/echo rebuilt/' Taskfile.pkl && rm -f Taskfile.pkl.bak"
    }
    argv { "describe"; "build-original" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new { exit = true; mustContain { "echo rebuilt" } }
  }
  new {
    id = "eval-cache-sees-an-edited-import"
    fixture = "examples/eval-cache"
    // The same, one level down: the entry point is untouched and a
    // module it imports changed. Keying on the Taskfile alone would
    // serve a stale plan here, which is why the entry records every
    // module the loader read and re-checks all of them.
    setup {
      "\"$PKF_MBT_BIN\" list > /dev/null"
      "sed -i.bak 's/build-original/build-renamed/' parts/names.pkl && rm -f parts/names.pkl.bak"
    }
    argv { "list" }
    env { ["PKFIRE_MBT_CACHE_DIR"] = ".pkf-cache" }
    contract = new { exit = true; mustContain { "build-renamed" } }
  }
  new {
    id = "clean-dry-run"
    fixture = "examples/cat-io"
    // `--dry-run` used to be accepted and ignored, so this exact
    // invocation printed "removed:" and removed them. The empty
    // fsDeleted golden is the assertion that matters.
    argv { "clean"; "--dry-run" }
    setup { "printf hi > src.txt"; "printf out > out.txt" }
    contract = new { exit = true; fsDelta = true; mustContain { "would remove" } }
  }
  new {
    id = "cache-stats-structural"
    fixture = "examples/basic"
    argv { "cache"; "stats" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "cache" } }
  }
  new {
    id = "pkl-cache-warm-structural"
    fixture = "examples/basic"
    argv { "pkl-cache"; "warm" }
    contract = new {
      exit = true
      mustContain { "warming "; "warmed "; "~/.pkl/cache is now populated" }
    }
  }
  new {
    id = "clean-glob"
    fixture = "examples/clean-glob"
    argv { "clean"; "gen*" }
    setup { "touch genA.out"; "touch genB.out" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "format-check-fail"
    fixture = "examples/unformatted"
    argv { "format"; "--check" }
    contract = new { exit = true; mustContainStderr { "pkl format exited" } }
  }
  new {
    id = "migrate-noref-error"
    fixture = "examples/migrate-2part"
    argv { "migrate"; "--to=0.11.0" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "no" } }
  }
  new {
    id = "init-positional-error"
    fixture = "examples/empty-dir"
    argv { "init"; "stray" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "positional" } }
  }
  // Glob import (phase 3 task 7): the root Taskfile assembles its task list
  // from `import* "tasks/*.pkl"`. The in-process glob resolver must produce
  // the same lex-sorted, glob-relative match set as Apple Pkl, so `list
  // --json` is byte-for-byte equal (after JSON normalization) Go-vs-MoonBit.
  // The glob is over a LOCAL dir — no network — but the fragments amend the
  // pkfire schema via `package://`, resolved from the warmed package cache
  // exactly like every other scenario here.
  new {
    id = "glob-import-list-json"
    fixture = "examples/glob-import"
    argv { "list"; "--json" }
    contract = new { json = true }
  }
  // NOTE on the `package://` amends conformance (phase 3 task 7):
  // there is deliberately NO live Go-vs-MoonBit `package://`-fixture scenario
  // here. Approach A (a committed fixture package seeded into BOTH caches for a
  // real differential) is intractable offline: the Go oracle uses pkl-go's
  // `PreconfiguredOptions`, which pins the package cache to `~/.pkl/cache`
  // with no env / cache-dir override, so the oracle cannot be redirected to a
  // hand-seeded temp cache hermetically, and seeding the real `~/.pkl/cache`
  // is neither dev-machine-safe nor reproducible on a fresh CI runner.
  // Approach B is used instead: `TestCandidatePackageAmendsOffline`
  // (package_amends_test.go) seeds only the pkl-mbt cache and asserts the
  // candidate evaluates a `package://` amends to a frozen expected JSON with
  // no network and no subprocess. The download path is unit-tested in
  // pkf (download_wbtest.mbt); the conformance test covers eval-from-cache.
}
