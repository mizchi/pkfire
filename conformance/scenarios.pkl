amends "Conformance.pkl"

scenarios {
  new {
    id = "list-json-basic"
    fixture = "examples/basic"
    argv { "list"; "--json" }
    contract = new {
      json = true
    }
  }
  new {
    id = "no-taskfile-error"
    fixture = "examples/empty-dir"
    argv { "list" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr { "pkf:" }
    }
  }
  new {
    id = "version"
    fixture = "examples/basic"
    argv { "version" }
    contract = new { exit = true; stdoutNonEmpty = true }
  }
  new {
    id = "help"
    fixture = "examples/basic"
    argv { "help" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "run" } }
  }
  new {
    id = "no-args"
    fixture = "examples/basic"
    argv {}
    contract = new { exit = true; stdoutNonEmpty = true }
  }
  new {
    id = "unknown-subcommand"
    fixture = "examples/basic"
    argv { "bogus" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "run" } }
  }
  new {
    id = "list-from-subdir"
    fixture = "examples/basic"
    argv { "list" }
    env { ["PKF_CONFORMANCE_SUBDIR"] = "sub" }
    setup { "mkdir -p sub" }
    contract = new { exit = true; mustContain { "hello" } }
  }
  new {
    id = "list-file-flag"
    fixture = "examples/basic"
    argv { "list"; "--file=Taskfile.pkl" }
    contract = new { exit = true; mustContain { "hello" } }
  }
  new {
    id = "run-output-from-subdir"
    fixture = "examples/cat-io"
    argv { "run"; "copy" }
    env { ["PKF_CONFORMANCE_SUBDIR"] = "sub" }
    setup { "mkdir -p sub"; "printf hi > src.txt" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "graph-json-basic"
    fixture = "examples/basic"
    argv { "graph"; "--json" }
    contract = new {
      json = true
      unorderedPaths { "edges" }
    }
  }
  new {
    id = "graph-json-kinds"
    fixture = "examples/graph-kinds"
    argv { "graph"; "--json" }
    contract = new { json = true; unorderedPaths { "edges" } }
  }
  new {
    id = "graph-json-kinds-all"
    fixture = "examples/graph-kinds"
    argv { "graph"; "--json"; "--all" }
    contract = new { json = true; unorderedPaths { "edges" } }
  }
  new {
    id = "describe-json-rich"
    fixture = "examples/describe-rich"
    argv { "describe"; "--json"; "deploy" }
    contract = new { json = true }
  }
  new {
    id = "describe-json-deps"
    fixture = "examples/describe-rich"
    argv { "describe"; "--json"; "app" }
    contract = new { json = true }
  }
  new {
    id = "describe-unknown"
    fixture = "examples/basic"
    argv { "describe"; "nope" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "unknown task" } }
  }
  new {
    id = "info-json-basic"
    fixture = "examples/basic"
    argv { "info"; "--json" }
    contract = new { json = true; jsonIgnorePaths { "taskfile" } }
  }
  new {
    id = "list-json-rich"
    fixture = "examples/describe-rich"
    argv { "list"; "--json" }
    contract = new { json = true }
  }
  new {
    id = "info-json-rich"
    fixture = "examples/describe-rich"
    argv { "info"; "--json" }
    contract = new { json = true; jsonIgnorePaths { "taskfile" } }
  }
  new {
    id = "describe-arg-after-json"
    fixture = "examples/describe-rich"
    argv { "describe"; "deploy"; "--json" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "single task name" } }
  }
  new {
    id = "completion-bash"
    fixture = "examples/basic"
    argv { "completion"; "bash" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "pkf bash completion" } }
  }
  new {
    id = "completion-zsh"
    fixture = "examples/basic"
    argv { "completion"; "zsh" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "#compdef pkf" } }
  }
  new {
    id = "completion-fish"
    fixture = "examples/basic"
    argv { "completion"; "fish" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "complete -c pkf" } }
  }
  new {
    id = "lint-clean"
    fixture = "examples/basic"
    argv { "lint"; "--json" }
    contract = new { json = true }
  }
  new {
    id = "lint-dead"
    fixture = "examples/lint-dead"
    argv { "lint"; "--json" }
    contract = new { json = true; exit = true; jsonIgnorePaths { "path" } }
  }
  new {
    id = "lint-rules"
    fixture = "examples/lint-rules"
    argv { "lint"; "--json" }
    contract = new { json = true; exit = true; jsonIgnorePaths { "path" } }
  }
  new {
    id = "lint-string-safe"
    fixture = "examples/lint-string-safe"
    argv { "lint"; "--json" }
    contract = new { json = true; exit = true; jsonIgnorePaths { "path" } }
  }
  new {
    id = "doctor-structural"
    fixture = "examples/basic"
    argv { "doctor"; "--json" }
    contract = new {
      exit = true
      mustContain {
        "checks"
        "level"
        "label"
        "message"
        "pkl"
        "cache"
        "remote"
        "taskfile"
        "pkf-path"
      }
    }
  }
  new {
    id = "explain-structural"
    fixture = "examples/basic"
    argv { "explain"; "build" }
    contract = new {
      exit = true
      mustContain { "task:"; "action key:"; "cmd:"; "shell:"; "input patterns" }
    }
  }
  new {
    id = "init-writes"
    fixture = "examples/empty-dir"
    argv { "init" }
    contract = new { exit = true; fsDelta = true; mustContainStderr { "wrote Taskfile.pkl" } }
  }
  new {
    id = "format-rewrites"
    fixture = "examples/unformatted"
    argv { "format" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "migrate-rewrites"
    fixture = "examples/migrate-src"
    argv { "migrate"; "--to=0.11.0"; "--skip-verify" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "migrate-dry-run"
    fixture = "examples/migrate-src"
    argv { "migrate"; "--to=0.11.0"; "--dry-run" }
    contract = new { exit = true; mustContain { "0.11.0" } }
  }
  new {
    id = "hooks-install"
    fixture = "examples/hooks-tf"
    argv { "hooks"; "install" }
    setup { "git init -q" }
    contract = new {
      exit = true
      fsDelta = true
      mustContain { "pre-commit" }
      mustContainStderr { "cache=true" }
    }
  }
  // A git-hook-named task must tolerate the positional args git hands
  // its hook scripts (`pkf hooks install` writes `pkf run <event> --
  // "$@"`, and e.g. pre-push gets `<remote> <url>`). The task here sets
  // no acceptsArgs, so this also pins that hook events are exempt from
  // the positional-args guard while the args stay ignored by the cmd.
  new {
    id = "run-hook-task-with-git-args"
    fixture = "examples/hooks-tf"
    argv { "run"; "pre-push"; "--"; "origin"; "https://example.com/repo.git" }
    contract = new { exit = true; mustContain { "running pre-push" } }
  }
  new {
    id = "clean-removes-outputs"
    fixture = "examples/cat-io"
    argv { "clean" }
    setup { "printf hi > src.txt"; "printf out > out.txt" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "cache-stats-structural"
    fixture = "examples/basic"
    argv { "cache"; "stats" }
    contract = new { exit = true; stdoutNonEmpty = true; mustContain { "cache" } }
  }
  new {
    id = "pkl-cache-warm-structural"
    fixture = "examples/basic"
    argv { "pkl-cache"; "warm" }
    contract = new {
      exit = true
      mustContain { "warming "; "warmed "; "~/.pkl/cache is now populated" }
    }
  }
  new {
    id = "clean-glob"
    fixture = "examples/clean-glob"
    argv { "clean"; "gen*" }
    setup { "touch genA.out"; "touch genB.out" }
    contract = new { exit = true; fsDelta = true }
  }
  new {
    id = "format-check-fail"
    fixture = "examples/unformatted"
    argv { "format"; "--check" }
    contract = new { exit = true; mustContainStderr { "pkl format exited" } }
  }
  new {
    id = "migrate-noref-error"
    fixture = "examples/migrate-2part"
    argv { "migrate"; "--to=0.11.0" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "no" } }
  }
  new {
    id = "init-positional-error"
    fixture = "examples/empty-dir"
    argv { "init"; "stray" }
    contract = new { exit = true; stdoutEmpty = true; mustContainStderr { "positional" } }
  }
  // Glob import (phase 3 task 7): the root Taskfile assembles its task list
  // from `import* "tasks/*.pkl"`. The in-process glob resolver must produce
  // the same lex-sorted, glob-relative match set as Apple Pkl, so `list
  // --json` is byte-for-byte equal (after JSON normalization) Go-vs-MoonBit.
  // The glob is over a LOCAL dir — no network — but the fragments amend the
  // pkfire schema via `package://`, resolved from the warmed package cache
  // exactly like every other scenario here.
  new {
    id = "glob-import-list-json"
    fixture = "examples/glob-import"
    argv { "list"; "--json" }
    contract = new { json = true }
  }
  // NOTE on the `package://` amends conformance (phase 3 task 7):
  // there is deliberately NO live Go-vs-MoonBit `package://`-fixture scenario
  // here. Approach A (a committed fixture package seeded into BOTH caches for a
  // real differential) is intractable offline: the Go oracle uses pkl-go's
  // `PreconfiguredOptions`, which pins the package cache to `~/.pkl/cache`
  // with no env / cache-dir override, so the oracle cannot be redirected to a
  // hand-seeded temp cache hermetically, and seeding the real `~/.pkl/cache`
  // is neither dev-machine-safe nor reproducible on a fresh CI runner.
  // Approach B is used instead: `TestCandidatePackageAmendsOffline`
  // (package_amends_test.go) seeds only the pkl-mbt cache and asserts the
  // candidate evaluates a `package://` amends to a frozen expected JSON with
  // no network and no subprocess. The download path is unit-tested in
  // pkf (download_wbtest.mbt); the conformance test covers eval-from-cache.
}
