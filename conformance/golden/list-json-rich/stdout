{
  "tasks": [
    {
      "name": "app",
      "visibility": "public",
      "cmd": "echo app",
      "shell": "bash",
      "shellFlags": [
        "-c"
      ],
      "deps": [
        "base"
      ],
      "cache": true,
      "service": false,
      "quiet": false,
      "acceptsArgs": false,
      "inheritEnv": true
    },
    {
      "name": "base",
      "visibility": "public",
      "cmd": "echo base",
      "shell": "bash",
      "shellFlags": [
        "-c"
      ],
      "cache": true,
      "service": false,
      "quiet": false,
      "acceptsArgs": false,
      "inheritEnv": true
    },
    {
      "name": "deploy",
      "description": "ship it",
      "visibility": "public",
      "cmd": "echo deploy",
      "shell": "bash",
      "shellFlags": [
        "-c"
      ],
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "dist/**"
      ],
      "workdir": "sub",
      "cache": true,
      "service": false,
      "quiet": false,
      "acceptsArgs": true,
      "inheritEnv": true,
      "params": [
        {
          "name": "region",
          "type": "enum",
          "choices": [
            "us",
            "eu"
          ],
          "default": "us",
          "description": "target region"
        }
      ]
    }
  ]
}
