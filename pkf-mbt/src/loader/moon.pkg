import {
  "mizchi/pkl" @pkl,
  "mizchi/x/http" @http,
  "mizchi/zlib" @zlib,
  "moonbitlang/core/json" @json,
  "moonbitlang/x/crypto" @crypto,
  "moonbitlang/async",
  "moonbitlang/async/http" @async_http,
  "moonbitlang/async/socket",
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/x/fs" @fs,
  "moonbitlang/x/sys" @sys,
  "moonbitlang/core/string" @string,
}

warnings = "-0029-0014-0024-0009-0020"

options(
  targets: {
    "loader.mbt": [ "native", "js" ],
    "fetch.mbt": [ "native" ],
    "fetch_wbtest.mbt": [ "native" ],
    "zip.mbt": [ "native" ],
    "zip_wbtest.mbt": [ "native" ],
    "download.mbt": [ "native" ],
    "download_wbtest.mbt": [ "native" ],
    "loader_wbtest.mbt": [ "native" ],
    "glob.mbt": [ "native", "js" ],
    "glob_wbtest.mbt": [ "native" ],
  },
)
