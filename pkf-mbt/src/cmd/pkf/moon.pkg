import {
  "mizchi/fswatch" @fswatch,
  "mizchi/pkf-mbt/src/loader" @loader,
  "mizchi/pkl" @pkl,
  "mizchi/x/fs" @xfs,
  "mizchi/x/http" @http,
  "mizchi/x/process" @process,
  "mizchi/x/signal" @signal,
  "mizchi/x/socket" @socket,
  "mizchi/zlib" @zlib,
  "moonbitlang/async",
  "moonbitlang/core/buffer" @buffer,
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/core/env" @env,
  "moonbitlang/core/json" @json,
  "moonbitlang/core/string" @string,
  "moonbitlang/x/crypto" @crypto,
  "moonbitlang/x/fs" @fs,
  "moonbitlang/x/sys" @sys,
