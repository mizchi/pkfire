import {
  "mizchi/fswatch",
  "mizchi/pkf/src/loader",
  "mizchi/pkl",
  "mizchi/x/fs" @xfs,
  "mizchi/x/http",
  "mizchi/x/process",
  "mizchi/x/signal",
  "mizchi/x/socket",
  "mizchi/zlib",
  "moonbitlang/async",
  "moonbitlang/async/semaphore",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/crypto",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

options(
  "native-stub": [ "stat_native.c", "signal_native.c", "eprint_native.c", "platform_native.c" ],
  targets: {
    "action.mbt": [ "native" ],
    "artifact.mbt": [ "native" ],
    "artifact_wbtest.mbt": [ "native" ],
    "cache_wbtest.mbt": [ "native" ],
    "fspy.mbt": [ "native" ],
    "graph_render.mbt": [ "native" ],
    "graph_render_wbtest.mbt": [ "native" ],
    "fspy_source.mbt": [ "native" ],
    "main.mbt": [ "native" ],
    "providers.mbt": [ "native" ],
    "providers_wbtest.mbt": [ "native" ],
    "replay.mbt": [ "native" ],
    "replay_wbtest.mbt": [ "native" ],
    "sandbox.mbt": [ "native" ],
    "sandbox_wbtest.mbt": [ "native" ],
    "schedule.mbt": [ "native" ],
    "schedule_wbtest.mbt": [ "native" ],
    "tar.mbt": [ "native" ],
    "watch_cycle.mbt": [ "native" ],
    "watch_cycle_wbtest.mbt": [ "native" ],
  },
)
