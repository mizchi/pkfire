name = "mizchi/pkf"

version = "0.12.4"

import {
  "mizchi/fswatch@0.2.1",
  "mizchi/pkl@0.3.3",
  "mizchi/x@0.5.1",
  "mizchi/zlib@0.4.8",
  "moonbitlang/async@0.20.2",
