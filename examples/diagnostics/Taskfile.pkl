/// pkfire diagnostics example.
///
/// This Taskfile is intentionally small and lint-clean while still
/// showing the fields and CLI commands that are easy to miss:
///
///   pkf list --all --json
///   pkf lint --json
///   pkf doctor --json
///   pkf explain ci
///   pkf clean --dry-run
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.10.0#/Taskfile.pkl"

local strictShellFlags: List<String> = List("-eu", "-o", "pipefail", "-c")

local renderReport = new Task {
  name = "render-report"
  description = "Write a generated report; intentionally uncached"
  cmd = "mkdir -p build && date -u > build/report.txt"
  shellFlags = strictShellFlags
  outputs { "build/report.txt" }

  // A task with outputs but no inputs would be suspicious if cache
  // were enabled: its action key would depend on nothing a user can
  // edit. `pkf lint` reports exactly that, and this line answers it.
  cache = false
}

local lintJson = new Task {
  name = "lint:json"
  description = "Emit machine-readable lint findings"
  cmd = "pkf lint --json"
  shellFlags = strictShellFlags
  cache = false
  quiet = true
}

local doctorJson = new Task {
  name = "doctor:json"
  description = "Emit machine-readable environment checks"
  cmd = "pkf doctor --json"
  shellFlags = strictShellFlags
  cache = false
  quiet = true
}

local auditList = new Task {
  name = "audit:list"
  description = "Every task, internal ones included, as JSON"
  cmd = "pkf list --all --json"
  shellFlags = strictShellFlags
  cache = false
  quiet = true
  visibility = "internal"
}

local cleanPlan = new Task {
  name = "clean:plan"
  description = "List the declared outputs `pkf clean` would remove"
  cmd = "pkf clean --dry-run"
  shellFlags = strictShellFlags
  cache = false
  quiet = true
  visibility = "internal"
}

local ci = new Task {
  name = "ci"
  description = "Deps-only umbrella task; no shell process is spawned"
  deps { lintJson; doctorJson; auditList; renderReport }
}

tasks { lintJson; doctorJson; auditList; cleanPlan; renderReport; ci }
