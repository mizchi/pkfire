/// Complex dogfood Taskfile (A2 schema): typed DAG, cross-compile matrix.
///
/// All deps are *direct Task references*; renaming a task in one place
/// updates every reference, and a typo becomes a Pkl name-resolution
/// error before the runner ever starts.
///
/// This file deliberately uses a relative `amends` to the in-tree
/// schema rather than the published package URI: it tests pkfire
/// against the schema in this commit, including unreleased changes.
/// Other examples use the package URI — see those for the recommended
/// form to copy into your own project.
amends "../../pkl/Taskfile.pkl"

local sources: Listing<String> = new {
  "cmd/**/*.go"
  "internal/**/*.go"
  "go.mod"
  "go.sum"
}

local repoRoot: String = "../.."

local class Platform {
  os: String
  arch: String
  fixed name: String = "\(os)-\(arch)"
}

local platforms: Listing<Platform> = new {
  new { os = "darwin"; arch = "arm64" }
  new { os = "darwin"; arch = "amd64" }
  new { os = "linux"; arch = "amd64" }
  new { os = "linux"; arch = "arm64" }
}

local function buildTask(p: Platform): Task = new {
  name = "build:\(p.name)"
  description = "Cross-compile pkf for \(p.name)"
  cmd = "go build -o bin/pkf-\(p.name) ./cmd/pkf"
  workdir = repoRoot
  env {
    ["GOOS"] = p.os
    ["GOARCH"] = p.arch
    ["CGO_ENABLED"] = "0"
  }
  inputs = sources
  outputs { "bin/pkf-\(p.name)" }
}

local builds: Listing<Task> = new {
  for (p in platforms) {
    buildTask(p)
  }
}

local vet: Task = new {
  name = "vet"
  description = "go vet"
  cmd = "go vet ./..."
  workdir = repoRoot
  inputs = sources
}

local goTest: Task = new {
  name = "go-test"
  description = "Go unit tests with race detector"
  cmd = "go test -race ./..."
  workdir = repoRoot
  inputs {
    ...sources
    "examples/**/*.pkl"
    "pkl/**/*.pkl"
  }
}

local pklTest: Task = new {
  name = "pkl-test"
  description = "Pkl schema tests"
  cmd = "pkl test pkl/Taskfile.test.pkl"
  workdir = repoRoot
  inputs {
    "pkl/Taskfile.pkl"
    "pkl/Taskfile.test.pkl"
    "pkl/Taskfile.test.pkl-expected.pcf"
  }
}

local checksum: Task = new {
  name = "checksum"
  description = "Aggregate SHA256 over the cross-compiled binaries"
  cmd = "cd bin && shasum -a 256 pkf-* > SHA256SUMS"
  workdir = repoRoot
  inputs {
    for (p in platforms) {
      "bin/pkf-\(p.name)"
    }
  }
  outputs { "bin/SHA256SUMS" }
  deps = builds
}

local integration: Task = new {
  name = "integration"
  description = "Smoke `pkf run hello` using the freshly built host binary"
  cmd = "bin/pkf-$(go env GOOS)-$(go env GOARCH) run -f examples/basic/Taskfile.pkl hello"
  workdir = repoRoot
  inputs {
    for (p in platforms) {
      "bin/pkf-\(p.name)"
    }
    "examples/basic/Taskfile.pkl"
    "pkl/Taskfile.pkl"
  }
  deps = builds
}

/// `pkf init` end-to-end: the cross-compiled host binary writes a
/// starter Taskfile, and we sanity-check that the file actually came
/// out structurally well-formed. The Go unit test (TestInitWritesSkeleton)
/// covers the same logic at the function level; this task catches
/// regressions that escape the unit test — a broken release-stamping
/// of `version`, a corrupted `initSkeleton` template after a refactor,
/// or a bin-layout mistake in the cross-compile step.
local initSmoke: Task = new {
  name = "init-smoke"
  description = "pkf init writes a structurally valid Taskfile (end-to-end)"
  cmd =
    """
    rm -rf bin/init-smoke && mkdir -p bin/init-smoke
    bin/pkf-$(go env GOOS)-$(go env GOARCH) init -f bin/init-smoke/Taskfile.pkl
    grep -q '^amends ' bin/init-smoke/Taskfile.pkl
    grep -q '^tasks {' bin/init-smoke/Taskfile.pkl
    """
  workdir = repoRoot
  inputs {
    for (p in platforms) {
      "bin/pkf-\(p.name)"
    }
    "cmd/pkf/main.go"
  }
  outputs { "bin/init-smoke/Taskfile.pkl" }
  deps = builds
}

local ci: Task = new {
  name = "ci"
  description = "Aggregate gate: vet, schema, unit tests, matrix, checksum, integration, init-smoke"
  cmd = "echo all green"
  cache = false
  deps { vet; pklTest; goTest; checksum; integration; initSmoke }
}

tasks {
  ...builds
  vet
  goTest
  pklTest
  checksum
  integration
  initSmoke
  ci
}
