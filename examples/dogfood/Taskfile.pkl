/// Complex dogfood Taskfile (A2 schema): typed DAG building the
/// MoonBit `pkf` from source.
///
/// All deps are *direct Task references*; renaming a task in one place
/// updates every reference, and a typo becomes a Pkl name-resolution
/// error before the runner ever starts.
///
/// This file deliberately uses a relative `amends` to the in-tree
/// schema rather than the published package URI: it tests pkfire
/// against the schema in this commit, including unreleased changes.
/// Other examples use the package URI — see those for the recommended
/// form to copy into your own project.
///
/// `pkf` itself is a MoonBit program (rooted at the repo root). The MoonBit
/// toolchain produces a single native binary per host; there is no
/// GOOS/GOARCH-style cross matrix, so this gate builds the host
/// binary once and exercises it end to end. Release cross-builds are
/// done on a runner matrix in `.github/workflows/pkl-publish.yml`.
amends "../../pkl/Taskfile.pkl"

local sources: Listing<String> = new {
  "src/**/*.mbt"
  "src/**/*.c"
  "src/**/moon.pkg"
  "moon.mod"
  "moon.work"
}

local repoRoot: String = "../.."

/// Path to the native release binary the MoonBit toolchain emits.
local pkfBin: String = "_build/native/release/build/mizchi/pkf/src/cmd/pkf/pkf.exe"

local moonCheck: Task = new {
  name = "moon-check"
  description = "Type-check the MoonBit sources (native target)"
  cmd = "moon check src/cmd/pkf src/loader --target native --deny-warn"
  workdir = repoRoot
  inputs = sources
}

local build: Task = new {
  name = "build"
  description = "Build the native release `pkf` binary"
  cmd = "moon build src/cmd/pkf --target native --release"
  workdir = repoRoot
  inputs = sources
  outputs { pkfBin }
}

local moonTest: Task = new {
  name = "moon-test"
  description = "MoonBit unit tests (native target)"
  cmd = "moon test src/cmd/pkf src/loader --target native"
  workdir = repoRoot
  inputs = sources
}

local pklTest: Task = new {
  name = "pkl-test"
  description = "Pkl schema tests"
  cmd = "pkl test pkl/Taskfile.test.pkl"
  workdir = repoRoot
  inputs {
    "pkl/Taskfile.pkl"
    "pkl/Taskfile.test.pkl"
    "pkl/Taskfile.test.pkl-expected.pcf"
  }
}

local integration: Task = new {
  name = "integration"
  description = "Smoke `pkf run hello` using the freshly built host binary"
  cmd = "\(pkfBin) run -f examples/basic/Taskfile.pkl hello"
  workdir = repoRoot
  inputs {
    pkfBin
    "examples/basic/Taskfile.pkl"
    "pkl/Taskfile.pkl"
  }
  deps { build }
}

/// `pkf init` end-to-end: the freshly built host binary writes a
/// starter Taskfile, and we sanity-check that the file actually came
/// out structurally well-formed. The MoonBit unit tests cover the same
/// logic at the function level; this task catches regressions that
/// escape the unit test — a broken release-stamping of `version`, a
/// corrupted `initSkeleton` template after a refactor, or a build
/// mistake.
local initSmoke: Task = new {
  name = "init-smoke"
  description = "pkf init writes a structurally valid Taskfile (end-to-end)"
  cmd =
    """
    rm -rf bin/init-smoke && mkdir -p bin/init-smoke
    \(pkfBin) init -f bin/init-smoke/Taskfile.pkl
    grep -q '^amends ' bin/init-smoke/Taskfile.pkl
    grep -q '^tasks {' bin/init-smoke/Taskfile.pkl
    """
  workdir = repoRoot
  inputs {
    pkfBin
    "src/cmd/pkf/**/*.mbt"
  }
  outputs { "bin/init-smoke/Taskfile.pkl" }
  deps { build }
}

local ci: Task = new {
  name = "ci"
  description = "Aggregate gate: moon-check, build, schema, unit tests, integration, init-smoke"
  cmd = "echo all green"
  cache = false
  deps { moonCheck; build; pklTest; moonTest; integration; initSmoke }
}

tasks {
  moonCheck
  build
  moonTest
  pklTest
  integration
  initSmoke
  ci
}
