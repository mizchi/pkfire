/// Split/import example: one runner entry point, task definitions split
/// across smaller Pkl modules.
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.10.0#/Taskfile.pkl"

import "tasks/build.pkl" as buildTasks
import "tasks/test.pkl" as testTasks

local ci = new Task {
  name = "ci"
  description = "Deps-only umbrella task assembled from imported fragments"
  deps { testTasks.test }
}

tasks {
  ...buildTasks.tasks
  ...testTasks.tasks
  ci
}
