/// Project-maintenance tasks for pkfire itself. This file is the
/// repo's task runner entry point; do not add a separate justfile or
/// Makefile for maintenance commands.
///
/// Build/test of the `pkf` binary lives in
/// `examples/dogfood/Taskfile.pkl` (cross-compile matrix + checksum
/// + integration smoke), which is what `.github/workflows/test.yml`
/// drives. Keep that file as the *release* gate; this file is the
/// *developer* gate.
///
/// Common entry points:
///   pkf run preflight              vet + tests + version + format consistency
///   pkf run bump --to=0.5.0        sweep pkfire@<old> → pkfire@0.5.0
///   pkf run tag                    create the pkfire@<ver> tag locally
///
/// Formatting is intentionally exposed as a Taskfile task too, so
/// `pkf run fmt` works the same way as other maintenance commands.
///
/// Relative `amends` so this file always tracks the in-tree schema
/// (including unreleased changes). External examples use the
/// published package URI; here we want to dogfood HEAD.
amends "pkl/Taskfile.pkl"

local sources: Listing<String> = new {
  "cmd/**/*.go"
  "cmd/pkf/completion/*"
  "internal/**/*.go"
  "go.mod"
  "go.sum"
}

local vet: Task = new {
  name = "vet"
  description = "go vet ./..."
  cmd = "go vet ./..."
  inputs = sources
}

local testGo: Task = new {
  name = "test:go"
  description = "Go unit tests (no -race for speed; use test:race when you want it)"
  cmd = "go test ./..."
  inputs {
    ...sources
    "examples/**/*.pkl"
    "pkl/**/*.pkl"
  }
}

local testRace: Task = new {
  name = "test:race"
  description = "Go unit tests with the race detector"
  cmd = "go test -race ./..."
  inputs {
    ...sources
    "examples/**/*.pkl"
    "pkl/**/*.pkl"
  }
}

local testPkl: Task = new {
  name = "test:pkl"
  description = "Pkl schema tests"
  cmd = "pkl test pkl/Taskfile.test.pkl"
  inputs {
    "pkl/Taskfile.pkl"
    "pkl/Taskfile.test.pkl"
    "pkl/Taskfile.test.pkl-expected.pcf"
  }
}

/// `pkl eval` every published example Taskfile. Catches schema
/// incompatibilities ("we added a required field and forgot to bump
/// the examples", "the examples are pinned to a version that no
/// longer evaluates against this binary") before they ship.
///
/// Pure eval — no toolchain dependencies, no actual task runs. The
/// node/rust/monorepo examples need their respective runtimes to
/// run tasks, but evaluation only needs `pkl` on PATH.
///
/// `examples/dogfood/Taskfile.pkl` is left out: it uses a relative
/// `amends "../../pkl/Taskfile.pkl"` and is exercised by `pkl
/// test` + the CI matrix already.
local testExamples: Task = new {
  name = "test:examples"
  description = "pkl eval every published example Taskfile"
  cmd =
    #"""
    set -euo pipefail
    for f in examples/basic/Taskfile.pkl examples/node/Taskfile.pkl examples/rust/Taskfile.pkl examples/monorepo/Taskfile.pkl examples/diagnostics/Taskfile.pkl examples/split-import/Taskfile.pkl; do
      echo "  eval $f"
      pkl eval "$f" >/dev/null
    done
    """#
  inputs {
    "pkl/Taskfile.pkl"
    "examples/basic/Taskfile.pkl"
    "examples/node/Taskfile.pkl"
    "examples/rust/Taskfile.pkl"
    "examples/monorepo/Taskfile.pkl"
    "examples/diagnostics/Taskfile.pkl"
    "examples/split-import/**/*.pkl"
  }
}

local lintTaskfile: Task = new {
  name = "lint:taskfile"
  description = "Detect local Task definitions omitted from tasks"
  cmd = "go run ./cmd/pkf lint"
  inputs {
    ...sources
    "Taskfile.pkl"
    "pkl/Taskfile.pkl"
  }
}

local testWorkflow: Task = new {
  name = "test:workflow"
  description = "Verify Taskfile workflowTests"
  cmd = "go run ./cmd/pkf affected --check"
  inputs {
    ...sources
    "Taskfile.pkl"
    "pkl/Taskfile.pkl"
  }
}

local checkVersion: Task = new {
  name = "check-version"
  description = "Verify every `pkfire@<ver>` reference matches pkl/PklProject"
  cmd = "scripts/check-version-consistency.sh"
  cache = false
}

local fmt: Task = new {
  name = "fmt"
  description = "Format all Pkl files in the repo"
  cmd = "pkl format -w Taskfile.pkl pkl examples skills"
  cache = false
}

local fmtCheck: Task = new {
  name = "fmt:check"
  description = "Check Pkl formatting without writing changes"
  cmd = "pkl format --diff-name-only Taskfile.pkl pkl examples skills"
  inputs {
    "Taskfile.pkl"
    "pkl/**/*.pkl"
    "examples/**/*.pkl"
    "skills/**/*.pkl"
  }
}

/// `pkf run bump --to=0.5.0` sweeps every `pkfire@<old>` reference
/// across the tree (README + skills + examples) and bumps the
/// declared `pkl/PklProject` version. Wrap of `scripts/bump-version.sh`
/// — kept as a shell script so it's also runnable without pkf
/// installed (e.g. in `gh workflow run` contexts).
local bump: Task = new {
  name = "bump"
  description = "Bump pkfire schema version + sweep all pkfire@<old> references"
  cmd = "scripts/bump-version.sh \"$TO\""
  cache = false
  params {
    new {
      name = "to"
      type = "string"
      description = "target version, e.g. 0.5.0 (required)"
    }
  }
}

/// Local-only: creates `pkfire@<ver-from-PklProject>` at HEAD but
/// does NOT push. Push manually after reviewing — that step
/// triggers the Release workflow + v-tags workflow and is hard to
/// undo without `gh release delete` ceremony.
local tag: Task = new {
  name = "tag"
  description = "Create the pkfire@<ver> tag locally (no push)"
  cache = false
  cmd =
    """
    set -euo pipefail
    ver=$(pkl eval -f json -x package.version pkl/PklProject | tr -d '"')
    tagname="pkfire@$ver"
    if git rev-parse "$tagname" >/dev/null 2>&1; then
      echo "tag $tagname already exists locally" >&2
      exit 1
    fi
    git tag "$tagname"
    echo "created tag: $tagname"
    echo "  push with: git push origin $tagname"
    """
}

/// Pre-commit gate. `pkf run preflight` is what you run before
/// pushing a feature branch / opening a PR. Skips the race
/// detector + the cross-compile matrix (those are CI's job).
local preflight: Task = new {
  name = "preflight"
  description = "Pre-commit gate: vet + go-test + pkl-test + examples + version + format"
  deps {
    vet
    testGo
    testPkl
    testExamples
    lintTaskfile
    testWorkflow
    checkVersion
    testReleaseNotes
    fmtCheck
  }
}

/// Verify the release-notes extractor stays correct. Catches
/// regressions like "edited CHANGELOG markup pattern" or "awk
/// quoting drift" before the Release workflow runs the same script
/// against an actual tag push.
local testReleaseNotes: Task = new {
  name = "test:release-notes"
  description = "Self-test for scripts/release-notes.sh"
  cmd = "scripts/release-notes_test.sh"
  cache = false
}

/// Git pre-commit hook target. `pkf hooks install` writes
/// `.git/hooks/pre-commit` as a shim that calls `pkf run pre-commit`.
/// This deps-only task delegates to preflight — putting it behind its own
/// task name keeps the hooks layer (config: which task wires to
/// which event) separate from the actual gate logic.
local preCommit: Task = new {
  name = "pre-commit"
  description = "Git pre-commit hook target (delegates to preflight)"
  deps { preflight }
}

workflowTests {
  new {
    name = "Go source changes run the developer gate"
    changed { "cmd/pkf/main.go" }
    direct { "vet"; "test:go"; "test:race"; "lint:taskfile"; "test:workflow" }
    tasks {
      "lint:taskfile"
      "check-version"
      "fmt:check"
      "test:examples"
      "test:go"
      "test:pkl"
      "test:release-notes"
      "test:workflow"
      "vet"
      "preflight"
      "pre-commit"
      "test:race"
    }
  }
}

tasks {
  vet
  testGo
  testRace
  testPkl
  testExamples
  lintTaskfile
  testWorkflow
  testReleaseNotes
  checkVersion
  fmt
  fmtCheck
  bump
  tag
  preflight
  preCommit
}
